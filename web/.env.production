# inmind fork: English UI by default (users can still switch language). Read by `next build` in every
# build path (install.sh, Dockerfile flow, release CI). Upstream default without this file: zh-CN.
NEXT_PUBLIC_DEFAULT_LANG=en-US

# Force SSE (activity stream etc.) to same-origin so it is proxied through the
# reverse proxy (Kong -> oauth2-proxy) like every other request. Without this the
# default base is ${hostname}:8787, which is the backend's internal-only port and
# is unreachable from a browser behind the proxy -> EventSource never opens ->
# the transcript panel spins on "Loading activity…" forever. Our proxy flushes SSE.
NEXT_PUBLIC_SSE_BASE=
